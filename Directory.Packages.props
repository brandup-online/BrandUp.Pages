<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<!-- BrandUp -->
		<PackageVersion Include="BrandUp.Website" Version="10.0.43" />
		<PackageVersion Include="BrandUp.Website.Abstractions" Version="10.0.43" />
		<PackageVersion Include="BrandUp.Extensions.Migrations" Version="10.0.6" />
		<PackageVersion Include="BrandUp.MongoDB" Version="10.0.16" />
		<PackageVersion Include="BrandUp.MongoDB.Testing.EphemeralMongo" Version="10.0.16" />

		<!-- Microsoft.Extensions -->
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />

		<!-- ASP.NET Core -->
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />

		<!-- Imaging / web -->
		<!-- Pinned to the last 3.x: ImageSharp 4.x requires a paid Six Labors license key at build time. -->
		<PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageVersion Include="WebMarkupMin.AspNetCoreLatest" Version="2.22.3" />

		<!-- Testing: xunit.v3 4.x runs on Microsoft.Testing.Platform v2, which dropped VSTest
		     on the .NET 10 SDK, so Microsoft.NET.Test.Sdk and xunit.runner.visualstudio are gone. -->
		<PackageVersion Include="xunit.v3" Version="4.0.0" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
	</ItemGroup>

</Project>
