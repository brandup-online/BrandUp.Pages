<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="BrandUp" value="https://pkgs.dev.azure.com/brandup/_packaging/BrandUp/nuget/v3/index.json" />
	</packageSources>

	<!--
	  Package source mapping: BrandUp.* packages come from the private Azure feed,
	  everything else from nuget.org. Makes restore reproducible and resolves NU1507
	  under central package management.
	-->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="BrandUp">
			<package pattern="BrandUp.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
